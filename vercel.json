{
  "cleanUrls": true,
  "redirects": [
    { "source": "/private/:path*", "destination": "/", "permanent": false },
    { "source": "/api/_:path*", "destination": "/", "permanent": false }
  ],
  "functions": {
    "api/content.js": { "includeFiles": "private/**" }
  },
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }] }
  ]
}
